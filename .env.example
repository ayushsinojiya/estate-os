# Copy this file to .env before running the root Docker Compose stack.
# Every REPLACE value is intentionally invalid. Never commit your real .env file.

# CRM database and API
POSTGRES_DB=estra_os
POSTGRES_USER=estraos
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_LOCAL_DATABASE_PASSWORD
API_PORT=8080
FRONTEND_PORT=3000
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEMO_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD_OF_12_OR_MORE_CHARACTERS
SPRING_PROFILES_ACTIVE=demo
INTEGRATIONS_MODE=mock
DEFAULT_COUNTRY_CODE=91

# Browser-facing API URL. This is embedded into the frontend build, so do not add secrets.
VITE_API_URL=http://localhost:8080/api/v1

# Knowledge ingestion service. Keep RAG_POSTGRES_PASSWORD and the password in
# RAG_DATABASES_JSON identical. Passwords in DSN JSON must be URL encoded.
RAG_POSTGRES_DB=estraos_knowledge
RAG_POSTGRES_USER=knowledge
RAG_POSTGRES_PASSWORD=REPLACE_WITH_A_URL_SAFE_KNOWLEDGE_DATABASE_PASSWORD
RAG_DATABASES_JSON={"1":"postgresql://knowledge:REPLACE_WITH_A_URL_SAFE_KNOWLEDGE_DATABASE_PASSWORD@knowledge-db:5432/estraos_knowledge"}
RAG_INGESTION_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RAG_PORT=8090
RAG_DB_PORT=55432
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_OCR_LANGUAGES=eng+hin+mar+guj

# Optional external providers. Keep mock mode unless these services are configured.
MISTRAL_API_KEY=
MISTRAL_EXTRACTION_MODEL=
RAG_SERVICE_URL=
RAG_API_KEY=
VOICE_AGENT_SERVICE_URL=
VOICE_AGENT_API_KEY=
NOTIFICATION_SERVICE_URL=
NOTIFICATION_API_KEY=
