# Copy to .env before running this directory's full-stack compose file.
# Every REPLACE value is intentionally invalid. Never commit the local .env file.
POSTGRES_DB=estate_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_LOCAL_DATABASE_PASSWORD
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
# Set false only for an existing database whose schema lacks Flyway history.
SPRING_FLYWAY_ENABLED=true
API_PORT=8080
FRONTEND_PORT=3000
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEMO_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD_OF_12_OR_MORE_CHARACTERS
SPRING_PROFILES_ACTIVE=demo
INTEGRATIONS_MODE=mock
DEFAULT_COUNTRY_CODE=91
VITE_API_URL=http://localhost:8080/api/v1

# Use a separate local PostgreSQL database with pgvector for each workspace.
# URL-encode the DSN password if it contains reserved characters.
RAG_DATABASES_JSON={"1":"postgresql://postgres:REPLACE_WITH_URL_ENCODED_LOCAL_DATABASE_PASSWORD@host.docker.internal:5432/client_1_knowledge"}
RAG_INGESTION_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RAG_PORT=8090
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_OCR_LANGUAGES=eng+hin+mar+guj
MISTRAL_API_KEY=
MISTRAL_EXTRACTION_MODEL=
