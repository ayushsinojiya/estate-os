# Copy to .env before running this directory's full-stack compose file.
# Every REPLACE value is intentionally invalid. Never commit the local .env file.
POSTGRES_DB=estate_os
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_LOCAL_DATABASE_PASSWORD
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
# Set false only for an existing database whose schema lacks Flyway history.
SPRING_FLYWAY_ENABLED=true
API_PORT=8080
FRONTEND_PORT=3000
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
DEMO_PASSWORD=REPLACE_WITH_A_LOCAL_DEMO_PASSWORD_OF_12_OR_MORE_CHARACTERS
SPRING_PROFILES_ACTIVE=demo
INTEGRATIONS_MODE=mock
DEFAULT_COUNTRY_CODE=91
VITE_API_URL=http://localhost:8080/api/v1

# Knowledge service (real-estate-ai-mvp/rag). One database for all workspaces, separate from the
# CRM database, with the vector and pg_trgm extensions (see LOCAL_SETUP.md). URL-encode the password.
RAG_DATABASE_URL=postgresql://postgres:REPLACE_WITH_URL_ENCODED_LOCAL_DATABASE_PASSWORD@host.docker.internal:5432/estraos_knowledge
# CRM <-> knowledge service bearer token. The same value on both.
RAG_SERVICE_URL=http://rag-api:8090
RAG_SERVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Voice agent -> knowledge service token, valid only for RAG_VOICE_WORKSPACE_ID.
RAG_VOICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RAG_VOICE_WORKSPACE_ID=1
RAG_PORT=8090
# live needs OPENAI_API_KEY; fake runs offline (lexical embedder, no vision parsing).
RAG_PROVIDER_MODE=live
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# Groq: reads projects and listings out of uploaded files for Projects & inventory.
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
PARSER_PROVIDER=openai
MISTRAL_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RERANKER=bge
COHERE_API_KEY=
# Outbound calls the CRM schedules through the voice agent. Times are Asia/Kolkata.
CALL_SCHEDULER_ENABLED=true
CALLING_HOURS_START=09:00
CALLING_HOURS_END=21:00
CALLING_RESUME_AT=09:30
VISIT_REMINDER_TIME=18:00
VISIT_REMINDER_SAME_DAY_HOURS=2
REENGAGE_AFTER_DAYS=7
REENGAGE_MAX_ATTEMPTS=2
DAILY_CALL_ATTEMPT_CAP=2
NEW_LEAD_CALL_DELAY_S=120
# Meta WhatsApp Cloud API. Leave blank to disable sends (they are recorded as failed).
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=REPLACE_WITH_WHATSAPP_ACCESS_TOKEN
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_LANG_MAP={"en":"en","hi":"hi","mr":"mr","gu":"gu"}
WHATSAPP_APP_SECRET=REPLACE_WITH_META_APP_SECRET
WHATSAPP_VERIFY_TOKEN=REPLACE_WITH_A_RANDOM_WEBHOOK_VERIFY_TOKEN
WHATSAPP_OFFICE_PHONE=
