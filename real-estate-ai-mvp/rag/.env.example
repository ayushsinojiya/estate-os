# Copy to .env before Docker Compose. Replace workspace 1 with an EXISTING CRM
# workspace ID. This is a NEW database, never the CRM database. Each additional
# workspace gets its own database/DSN. Passwords inside DSNs must be URL encoded.
RAG_POSTGRES_DB=estraos_knowledge
RAG_POSTGRES_USER=knowledge
RAG_POSTGRES_PASSWORD=REPLACE_WITH_A_URL_SAFE_LOCAL_PASSWORD
RAG_DATABASES_JSON={"1":"postgresql://knowledge:REPLACE_WITH_A_URL_SAFE_LOCAL_PASSWORD@knowledge-db:5432/estraos_knowledge"}
RAG_INGESTION_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RAG_PORT=8090
RAG_DB_PORT=55432
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_STORAGE_PATH=./storage
RAG_POLL_SECONDS=2
RAG_OCR_LANGUAGES=eng+hin+mar+guj
# Only required for narrative/layout documents, not deterministic spreadsheets.
MISTRAL_API_KEY=
MISTRAL_EXTRACTION_MODEL=
