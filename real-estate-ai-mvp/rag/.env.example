# Replace workspace 1 with an EXISTING CRM workspace ID. This is a NEW database,
# never the CRM database. Each additional workspace gets its own database/DSN.
RAG_POSTGRES_PASSWORD=replace-with-url-safe-local-password
RAG_DATABASES_JSON={"1":"postgresql://knowledge:replace-with-url-safe-local-password@knowledge-db:5432/estateos_knowledge"}
RAG_INGESTION_TOKEN=replace-with-at-least-32-random-characters
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
RAG_STORAGE_PATH=./storage
RAG_OCR_LANGUAGES=eng+hin+mar+guj
# Only required for narrative/layout documents, not deterministic spreadsheets.
MISTRAL_API_KEY=
MISTRAL_EXTRACTION_MODEL=
