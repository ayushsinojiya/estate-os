# Knowledge service. Copy to .env; never commit real keys.
# One knowledge database for every workspace (separate from the CRM database). Create it once:
#   CREATE DATABASE estraos_knowledge;  \c estraos_knowledge
#   CREATE EXTENSION vector; CREATE EXTENSION pg_trgm;
RAG_DATABASE_URL=postgresql://rag:REPLACE_WITH_URL_ENCODED_PASSWORD@host.docker.internal:5432/estraos_knowledge
RAG_STORAGE_PATH=./storage

# CRM -> RAG bearer token (same value as RAG_SERVICE_TOKEN on the CRM).
RAG_SERVICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
# Voice agent -> RAG bearer token, valid for exactly one workspace.
RAG_VOICE_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RAG_VOICE_WORKSPACE_ID=1

# live = OpenAI/Mistral/Cohere; fake = offline (hashing embedder, PDF text layer, overlap reranker).
PROVIDER_MODE=live
OPENAI_API_KEY=REPLACE_WITH_OPENAI_API_KEY
# Groq (or any OpenAI-compatible API via EXTRACTION_BASE_URL): projects and listings for the CRM.
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
EXTRACTION_MODEL=llama-3.3-70b-versatile
PARSER_PROVIDER=openai
PARSER_MODEL=gpt-4.1-mini
MISTRAL_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# bge = local BAAI/bge-reranker-v2-m3 on CPU; cohere needs COHERE_API_KEY; none disables.
RERANKER=bge
RERANK_BUDGET_MS=150
# Live calls: past this the query embedding is skipped and keyword/name search answers alone.
VOICE_EMBED_BUDGET_MS=300
COHERE_API_KEY=
REWRITE_ON_VOICE=false
