server.port=${PORT:8080}
server.error.include-message=never

spring.application.name=estateos-api
spring.profiles.active=${SPRING_PROFILES_ACTIVE:demo}
spring.datasource.url=${DATABASE_URL:jdbc:postgresql://localhost:5432/estate_os}
spring.datasource.username=${DATABASE_USERNAME:postgres}
spring.datasource.password=${DATABASE_PASSWORD:REPLACE_WITH_DATABASE_PASSWORD}
spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=validate
spring.flyway.enabled=false
spring.servlet.multipart.max-file-size=50MB
spring.servlet.multipart.max-request-size=250MB
spring.jackson.deserialization.fail-on-unknown-properties=true

management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=never

app.jwt-secret=${JWT_SECRET:REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES}
app.token-minutes=${JWT_TOKEN_MINUTES:60}
app.cors-origins=${CORS_ALLOWED_ORIGINS:http://localhost:5173}
app.demo-password=${DEMO_PASSWORD:REPLACE_WITH_AT_LEAST_12_CHARACTERS}

app.integrations.mode=${INTEGRATIONS_MODE:mock}
app.integrations.connect-timeout-ms=${INTEGRATION_CONNECT_TIMEOUT_MS:3000}
app.integrations.read-timeout-ms=${INTEGRATION_READ_TIMEOUT_MS:10000}
app.integrations.rag.url=${RAG_SERVICE_URL:https://rag.example.invalid}
app.integrations.rag.api-key=${RAG_API_KEY:REPLACE_WITH_PROVIDER_TOKEN}
app.integrations.voice.url=${VOICE_AGENT_SERVICE_URL:https://voice.example.invalid}
app.integrations.voice.api-key=${VOICE_AGENT_API_KEY:REPLACE_WITH_PROVIDER_TOKEN}
app.integrations.notification.url=${NOTIFICATION_SERVICE_URL:https://notifications.example.invalid}
app.integrations.notification.api-key=${NOTIFICATION_API_KEY:REPLACE_WITH_PROVIDER_TOKEN}

app.notifications.reminders-enabled=${NOTIFICATION_REMINDERS_ENABLED:true}
app.notifications.reminder-poll-ms=${NOTIFICATION_REMINDER_POLL_MS:60000}
app.files.storage-path=${FILE_STORAGE_PATH:./storage/files}
app.ingestion.url=${RAG_INGESTION_URL:http://localhost:8090}
app.ingestion.token=${RAG_INGESTION_TOKEN:REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS}
app.ingestion.connect-timeout-ms=${RAG_INGESTION_CONNECT_TIMEOUT_MS:3000}
app.ingestion.read-timeout-ms=${RAG_INGESTION_READ_TIMEOUT_MS:60000}

springdoc.swagger-ui.path=/swagger-ui.html
