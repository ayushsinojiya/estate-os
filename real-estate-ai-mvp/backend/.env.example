# Copy to .env for Docker Compose or export values before launching Java/Maven.
# Every REPLACE value is intentionally invalid. Never commit your local .env.
POSTGRES_DB=estra_os
POSTGRES_USER=estraos
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_LOCAL_DATABASE_PASSWORD
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/estra_os
SPRING_DATASOURCE_USERNAME=estraos
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_A_LONG_LOCAL_DATABASE_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_TOKEN_MINUTES=60
PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Assumed for national numbers the voice agent reports without a country code.
DEFAULT_COUNTRY_CODE=91
# Demo only: explicit profile, caller-chosen password. Remove demo in production.
SPRING_PROFILES_ACTIVE=demo
DEMO_PASSWORD=REPLACE_WITH_AT_LEAST_12_CHARACTERS
INTEGRATIONS_MODE=mock
# Voice agent service login. The agent calls POST /api/v1/auth/login with these credentials,
# so it is subject to the same membership, role and session rules as a human user.
# Leave the email blank to disable machine access entirely.
SERVICE_ACCOUNT_EMAIL=voice-agent@example.invalid
SERVICE_ACCOUNT_PASSWORD=REPLACE_WITH_AT_LEAST_16_CHARACTERS
SERVICE_ACCOUNT_WORKSPACE_ID=1
# Set on a clean database to create that workspace on first boot; ignored once it exists.
SERVICE_ACCOUNT_WORKSPACE_NAME=Primary workspace
# Production/provisional REST adapter settings (INTEGRATIONS_MODE=rest)
RAG_SERVICE_URL=https://rag.example.invalid
RAG_API_KEY=REPLACE_WITH_PROVIDER_TOKEN
VOICE_AGENT_SERVICE_URL=https://voice.example.invalid
VOICE_AGENT_API_KEY=REPLACE_WITH_PROVIDER_TOKEN
NOTIFICATION_SERVICE_URL=https://notifications.example.invalid
NOTIFICATION_API_KEY=REPLACE_WITH_PROVIDER_TOKEN
INTEGRATION_CONNECT_TIMEOUT_MS=3000
INTEGRATION_READ_TIMEOUT_MS=10000
NOTIFICATION_REMINDERS_ENABLED=true
NOTIFICATION_REMINDER_POLL_MS=60000
# Root for workspace-isolated file uploads. This directory must be writable by the service user.
FILE_STORAGE_PATH=./storage/files
# Dedicated Python knowledge ingestion service (independent of the legacy RAG adapter).
# When this API runs in its own Compose project, the knowledge API is reached
# through the Windows Docker host. Use http://knowledge-api:8090 in the full root stack.
RAG_INGESTION_URL=http://host.docker.internal:8090
# Required: use the same randomly generated token on both services. Never expose it to the browser.
RAG_INGESTION_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
RAG_INGESTION_CONNECT_TIMEOUT_MS=3000
RAG_INGESTION_READ_TIMEOUT_MS=60000
